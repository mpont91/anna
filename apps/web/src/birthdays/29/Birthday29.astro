---
import { Gift } from '@lucide/astro'

const rows = [
  [
    ['H', '#f54747'],
    ['A', '#fe864a'],
    ['P', '#feef66'],
    ['P', '#7fff62'],
    ['Y', '#8fffd4'],
  ],
  [
    ['2', '#7fff62'],
    ['9', '#8fffd4'],
  ],
  [
    ['B', '#4a74fe'],
    ['I', '#984afe'],
    ['R', '#fe4ae6'],
    ['T', '#fe4a98'],
    ['H', '#fe7d4a'],
    ['D', '#feef66'],
    ['A', '#7fff62'],
    ['Y', '#8fffd4'],
  ],
  [
    ['A', '#fe7d4a'],
    ['N', '#feef66'],
    ['N', '#7fff62'],
    ['A', '#8fffd4'],
  ],
]
const layers = [5, 6, 7]
---

<div class="page">
  {rows.map((row) => (
    <div class="message">
      {row.map(([letter, color]) => (
        <span class="cube" style={`--clr:${color};`}>
          {letter}
        </span>
      ))}
    </div>
  ))}
  <div class="cake">
    {layers.map((creams) => (
      <div class="layer">
        {Array.from({ length: creams }, (_, i) => (
          <div class="cream" style={`--i:${i};`} />
        ))}
      </div>
    ))}
    <div class="candle"></div>
  </div>
  <div class="plate"></div>
  <div class="gift">
    <Gift size={96} />
  </div>
</div>

<script>
  import { createTimeline, stagger } from 'animejs'

  createTimeline({ loop: true })
    .add('.message .cube', {
      scale: [2, 1],
      opacity: [0, 1],
      ease: 'outExpo',
      duration: 100,
      delay: stagger(70),
    })
    .add('.message .cube', {
      scale: [1, 0],
      opacity: 0,
      duration: 950,
      ease: 'inQuad',
      delay: stagger(70),
    })
</script>

<style>
  .page {
    width: 100%;
    min-height: 100vh;
    justify-content: center;
    align-items: center;
    display: flex;
    flex-direction: column;
    background: linear-gradient(#9485f4, #7fff62);
    animation: changeBg 6s linear infinite;
  }

  @keyframes changeBg {
    0% {
      backdrop-filter: hue-rotate(0deg);
    }
    100% {
      backdrop-filter: hue-rotate(360deg);
    }
  }

  .message {
    justify-content: center;
    align-items: center;
    display: flex;
    flex-direction: row;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 2em;
    opacity: 0.75;
    transform: translateY(-225px);
  }

  span {
    margin: 0.2em;
    user-select: none;
    padding-top: 6px;
  }

  .cube {
    text-align: center;
    width: 50px;
    height: 50px;
    background: var(--clr);
  }

  .cake {
    width: 400px;
    height: 400px;
    position: absolute;
    justify-content: center;
    align-items: center;
    display: flex;
    flex-direction: column;
    z-index: 2;
    animation: upDown 4s ease-in-out infinite;
  }

  @keyframes upDown {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .layer {
    width: 300px;
    height: 75px;
    position: relative;
    background: #fe864a;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    overflow: hidden;
    transform: translateY(87px);
  }

  .layer::before {
    content: '';
    position: absolute;
    background: #eee27c;
    width: 100%;
    height: 5px;
    transform: translateY(50px);
  }

  .layer::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 30px;
    background: linear-gradient(rgb(252, 163, 163), transparent);
    border-radius: 20px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-size: 20%;
  }

  .cream {
    width: 60px;
    height: 30px;
    position: absolute;
    border-radius: 30px;
    background: #e6fe4a;
    border-top-right-radius: 0;
    border-top-left-radius: 0;
    transform: translateX(calc(60px * var(--i)));
    animation: move 4s ease-in-out infinite;
  }

  @keyframes move {
    0%,
    100% {
      transform: translateX(calc(60px * var(--i)));
    }
    50% {
      transform: translateX(calc(40px * var(--i)));
    }
  }

  div .layer:nth-child(1) {
    width: 200px;
    filter: hue-rotate(260deg);
  }

  div .layer:nth-child(2) {
    width: 250px;
    filter: hue-rotate(324deg);
  }

  .candle {
    width: 8px;
    height: 40px;
    background: #f57647;
    position: absolute;
    border-radius: 5px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transform: translateY(-45px);
  }

  .candle::before {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    background: #fe4a4a;
    border-radius: 50%;
    border-top-right-radius: 0;
    transform: rotate(-45deg) translate(9px, -12px);
  }

  .plate {
    width: 400px;
    height: 60px;
    background: #d7d7d7;
    position: absolute;
    border-radius: 50%;
    transform: translateY(210px);
    justify-content: center;
    align-items: center;
    display: flex;
  }

  .plate::before {
    content: '';
    position: absolute;
    width: 65%;
    height: 65%;
    border-radius: 50%;
    background: #e4e4e4;
    box-shadow: inset 10px 10px 10px #bbbbbb;
    z-index: 4;
  }

  .plate::after {
    content: '';
    position: absolute;
    width: 60%;
    height: 60%;
    border-radius: 33%;
    background: #d7d7d7;
    transform: translateY(20px);
    z-index: 3;
  }

  .gift {
    display: flex;
    color: #f44336;
    border-radius: 50%;
    transform: translateY(200px);
    cursor: pointer;
    animation: pulse 1.5s infinite;
  }

  /* The ring Materialize's `pulse` drew around the gift. */
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(244, 67, 54, 0.6);
    }
    70% {
      box-shadow: 0 0 0 20px rgba(244, 67, 54, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(244, 67, 54, 0);
    }
  }
</style>
