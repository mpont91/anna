---
import type { ImageMetadata } from 'astro'
import Scene from './Scene.astro'

const photos = import.meta.glob<{ default: ImageMetadata }>('./assets/*.jpg', {
  eager: true,
})

function photo(name: string): ImageMetadata {
  const module = photos[`./assets/${name}.jpg`]
  if (!module) throw new Error(`Missing photo: ${name}.jpg`)
  return module.default
}

// An album is named after its files: menorca1.jpg … menorca6.jpg.
function album(name: string, count: number): ImageMetadata[] {
  return Array.from({ length: count }, (_, i) => photo(`${name}${i + 1}`))
}

const sushi = photo('sushi')
const beef = photo('beef')
const spa = photo('spa')

interface SceneProps {
  title: string
  text?: string
  bgClass: string
